    WithRotaCount = Table.AddColumn(
        WithDuration,
        "Rota Session Count",
        each
            let
                SlotStart = [Slot Start Time],
                SlotEnd = [Slot End Time],
                StartDate = Date.From(SlotStart),
                EndDate = Date.From(SlotEnd),
                StartClock = Time.From(SlotStart),
                EndClock = Time.From(SlotEnd),
                IsNineToFive =
                    EndDate = StartDate
                    and StartClock = #time(9, 0, 0)
                    and EndClock = #time(17, 0, 0),
                IsMidnightToMidnight =
                    EndDate = Date.AddDays(StartDate, 1)
                    and StartClock = #time(0, 0, 0)
                    and EndClock = #time(0, 0, 0)
            in
                [No of Sessions] *
                    (if IsNineToFive or IsMidnightToMidnight then 2 else 1),
        Int64.Type
    ),
